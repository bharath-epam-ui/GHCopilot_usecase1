# ============================================================
# kata-taskmanager — Local Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the secret values.
# .env.local is gitignored and must NEVER be committed.
#
#   cp .env.local.example .env.local
# ============================================================

# ------------------------------------------------------------
# 1. App — Vercel KV (Upstash Redis)
#    Required for production. Without these the app uses
#    in-memory storage (fine for local dev, resets on restart).
#    Get values from: Vercel Dashboard → Settings → Env Vars
# ------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ------------------------------------------------------------
# 2. Jira — Agentic SDLC Pipeline
#    Used by Agent 01 (Requirements) to fetch story details.
#    JIRA_BASE_URL    : your Atlassian domain (no trailing slash)
#    JIRA_EMAIL       : Atlassian account email (used for Basic auth)
#    JIRA_API_TOKEN   : generate at https://id.atlassian.com/manage-profile/security/api-tokens
#    JIRA_PROJECT_KEY : project key shown in the board URL (e.g. KT)
# ------------------------------------------------------------
JIRA_BASE_URL=https://bharathwaj1390.atlassian.net
JIRA_EMAIL=bharathwaj1390@gmail.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KT

# ------------------------------------------------------------
# 3. GitHub — PR and Repository Operations
#    Used by Agent 08 (PR) to create pull requests via API.
#    GITHUB_REPO_OWNER : GitHub username or org
#    GITHUB_REPO_NAME  : repository name
#    GITHUB_EMAIL      : git commit author email
#    GITHUB_TOKEN      : generate at https://github.com/settings/tokens
#                        Required scopes: repo, pull_requests
# ------------------------------------------------------------
GITHUB_REPO_OWNER=bharath-epam-ui
GITHUB_REPO_NAME=GHCopilot_usecase1
GITHUB_EMAIL=
GITHUB_TOKEN=

